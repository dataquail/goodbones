{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "schedule": {
      "type": "string"
    },
    "activeHours": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "launcher": {
      "type": "string"
    },
    "launchers": {
      "not": {},
      "description": "launcher commands can only be defined in machine config (~/.config/chernabog/config.yaml)"
    },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string"
          },
          "concurrency": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "agent": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {}
}
