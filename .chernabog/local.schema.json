{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "schedule": {
      "type": "string"
    },
    "activeHours": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "launcher": {
      "type": "string"
    },
    "launchers": {
      "not": {},
      "description": "launcher commands can only be defined in machine config (~/.config/chernabog/config.yaml)"
    },
    "runners": {
      "not": {},
      "description": "runners is the team's choice, in .chernabog/config.yaml; to run a flow here anyway, set flows.<flow>.enabled: true"
    },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string"
          },
          "concurrency": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "agent": {
            "type": "string"
          },
          "assignee": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "Start only work items whose assignees include one of these: @me for this machine's GitHub login, a login, or none for nobody. null clears the team's."
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewRequested": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "Start only work items whose requested reviewers include one of these: @me for this machine's GitHub login, a login, or none for nobody. null clears the team's."
              },
              {
                "type": "null"
              }
            ]
          },
          "runners": {
            "not": {},
            "description": "runners is the team's choice, in .chernabog/config.yaml; to run a flow here anyway, set flows.<flow>.enabled: true"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {}
}
