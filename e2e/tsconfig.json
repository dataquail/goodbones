{
  // The harness imports no `@goodbones/*` source, on purpose: it spawns the
  // built bin and the built plugin, so there is nothing to reference here.
  "extends": "../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "outDir": "build",
    "tsBuildInfoFile": ".tsbuildinfo/e2e.tsbuildinfo",
    "paths": {}
  }
}
