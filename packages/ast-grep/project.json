{
  "name": "@goodbones/ast-grep",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ast-grep/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/build", "{projectRoot}/.tsbuildinfo"],
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/ast-grep"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/.tsbuildinfo", "{projectRoot}/build/src"],
      "options": {
        "command": "pnpm run check",
        "cwd": "packages/ast-grep"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/ast-grep"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec oxlint --type-aware --quiet packages/ast-grep",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": []
}
