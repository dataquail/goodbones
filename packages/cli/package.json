{
  "name": "@goodbones/cli",
  "version": "0.1.0-beta.6",
  "type": "module",
  "license": "MIT",
  "description": "The architecture CLI for @goodbones/core: check, baseline, coverage, explain and facts over a whole repository with no linter in the loop, including the graph family (cycles, orphans, transitive reach) that only an adapter seeing every file at once can evaluate.",
  "author": "zacharyweidenbach",
  "keywords": [
    "architecture",
    "lint",
    "import-boundaries",
    "hexagonal",
    "monorepo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataquail/goodbones.git",
    "directory": "packages/cli"
  },
  "homepage": "https://dataquail.github.io/goodbones",
  "bugs": {
    "url": "https://github.com/dataquail/goodbones/issues"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "architecture": "./build/esm/main.js"
  },
  "files": [
    "build/dts",
    "build/esm",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "clean": "rm -rf build .tsbuildinfo",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@goodbones/core": "workspace:*",
    "@goodbones/typescript": "workspace:*",
    "effect": "4.0.0-beta.94"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  },
  "nx": {
    "includedScripts": []
  }
}
