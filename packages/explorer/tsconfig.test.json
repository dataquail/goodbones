{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "tsconfig.src.json" }],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "outDir": "build/test",
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "paths": {}
  }
}
