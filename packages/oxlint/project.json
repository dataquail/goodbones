{
  "name": "@goodbones/oxlint",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/oxlint/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/build", "{projectRoot}/.tsbuildinfo"],
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/oxlint"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/.tsbuildinfo", "{projectRoot}/build/src"],
      "options": {
        "command": "pnpm run check",
        "cwd": "packages/oxlint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/oxlint"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec oxlint --type-aware --quiet packages/oxlint",
        "cwd": "{workspaceRoot}",
        "env": { "NODE_OPTIONS": "--experimental-strip-types --no-warnings" }
      }
    }
  },
  "tags": []
}
