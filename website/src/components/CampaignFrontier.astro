---
// The same campaign at three points in time. Defined phases grow left to right; the open phase —
// intent only — always sits last, at the edge of what the team knows, and is refined into defined
// phases as sectors reach it and the next step becomes clear.
type Row = {
  when: string;
  sub: string;
  defined: string[];
  open: string;
};
const rows: Row[] = [
  {
    when: "Day one",
    sub: "first step only",
    defined: ["domain"],
    open: "“a repository, somehow”",
  },
  {
    when: "Weeks later",
    sub: "sectors reached it",
    defined: ["domain", "repository", "dual-write"],
    open: "“then cut over?”",
  },
  {
    when: "Months later",
    sub: "mostly known",
    defined: ["domain", "repository", "dual-write", "backfilled", "cutover"],
    open: "“aggregates: undecided”",
  },
];
const x0 = 150;
const w = 92;
const gap = 14;
const col = (i: number) => x0 + i * (w + gap);
const rowY = (r: number) => 40 + r * 118;
const boxH = 46;
const last = col(5) + w;
---

<figure class="campaign-figure">
  <div class="scroll">
    <svg
      viewBox="0 0 800 420"
      role="img"
      aria-labelledby="cf-title cf-desc"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title id="cf-title">Defining phases as you go</title>
      <desc id="cf-desc">
        The same campaign at three points in time. On day one only the first phase is defined and
        the rest is an open phase carrying only an intent. As sectors reach the open phase and the
        team learns, it is refined into defined phases, and a new open phase sits at the edge of
        what is known. Months later five phases are defined and one open phase remains.
      </desc>
      <defs>
        <marker
          id="cf-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L10,5 L0,10 z" class="arrowhead"></path>
        </marker>
        <linearGradient id="cf-fog" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" class="fog-start"></stop>
          <stop offset="1" class="fog-end"></stop>
        </linearGradient>
      </defs>

      {
        rows.map((r, ri) => {
          const y = rowY(ri);
          const openI = r.defined.length;
          return (
            <g>
              <text x="16" y={y + 20} class="label">
                {r.when}
              </text>
              <text x="16" y={y + 38} class="muted small">
                {r.sub}
              </text>

              {r.defined.map((d, i) => (
                <g>
                  <rect x={col(i)} y={y} width={w} height={boxH} rx="8" class="defined" />
                  <text x={col(i) + w / 2} y={y + 20} class="eyebrow" text-anchor="middle">
                    DEFINED
                  </text>
                  <text x={col(i) + w / 2} y={y + 37} class="phase-name" text-anchor="middle">
                    {d}
                  </text>
                  <line
                    x1={col(i) + w + 1}
                    y1={y + boxH / 2}
                    x2={col(i) + w + gap - 1}
                    y2={y + boxH / 2}
                    class="connector"
                    marker-end="url(#cf-arrow)"
                  />
                </g>
              ))}

              {openI < 5 && (
                <rect
                  x={col(openI) + w + 4}
                  y={y}
                  width={last - (col(openI) + w + 4)}
                  height={boxH}
                  rx="8"
                  fill="url(#cf-fog)"
                />
              )}
              {openI < 5 && (
                <text x={col(openI) + w + 18} y={y + 28} class="fog-text">
                  not known yet
                </text>
              )}

              <rect x={col(openI)} y={y} width={w} height={boxH} rx="8" class="open" />
              <text x={col(openI) + w / 2} y={y + 20} class="eyebrow open-text" text-anchor="middle">
                OPEN
              </text>
              <text x={col(openI) + w / 2} y={y + 37} class="phase-name open-text" text-anchor="middle">
                intent only
              </text>
              <text x={col(openI) + w / 2} y={y + boxH + 18} class="intent" text-anchor="middle">
                {r.open}
              </text>
            </g>
          );
        })
      }

      <!-- refinement between snapshots -->
      {
        [0, 1].map((ri) => {
          const from = rows[ri].defined.length;
          const to = rows[ri + 1].defined.length;
          const y1 = rowY(ri) + boxH + 26;
          const y2 = rowY(ri + 1) - 6;
          return (
            <g>
              <path
                d={`M ${col(from) + w / 2} ${y1} C ${col(from) + w / 2} ${y1 + 22}, ${col(to) + w / 2} ${y2 - 22}, ${col(to) + w / 2} ${y2}`}
                class="refine"
                marker-end="url(#cf-arrow)"
              />
              <text x={col(from) + w / 2 - 12} y={y1 + 22} class="refine-text" text-anchor="end">
                learned → refined
              </text>
            </g>
          );
        })
      }

      <text x="16" y="392" class="body">
        Defined phases are deterministic: detectors, ledgers, a ratchet. The open phase is intent and
        notes —
      </text>
      <text x="16" y="410" class="body">
        the edge of what the team knows. Each sector that reaches it teaches the next step, which is
        then written down.
      </text>
    </svg>
  </div>
  <figcaption>
    The plan is written as far as it is known. The open phase moves right as the refactor teaches
    the team what comes next.
  </figcaption>
</figure>

<style>
  .campaign-figure {
    margin-block: 1.5rem;
  }
  .scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
    font-family: var(--__sl-font);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .label {
    font-size: 13px;
    font-weight: 600;
    fill: var(--sl-color-white);
  }
  .body {
    font-size: 12.5px;
    fill: var(--sl-color-text);
  }
  .muted {
    fill: var(--sl-color-gray-3);
  }
  .small {
    font-size: 11px;
  }
  .eyebrow {
    font-size: 9px;
    letter-spacing: 0.08em;
    font-weight: 600;
    fill: var(--sl-color-accent-high);
  }
  .phase-name {
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--sl-color-white);
  }
  .defined {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
  }
  .open {
    fill: var(--sl-color-bg);
    stroke: var(--sl-color-orange);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .open-text {
    fill: var(--sl-color-orange-high);
  }
  .intent {
    font-size: 11px;
    font-style: italic;
    fill: var(--sl-color-gray-3);
  }
  .fog-start {
    stop-color: var(--sl-color-gray-5);
    stop-opacity: 0.6;
  }
  .fog-end {
    stop-color: var(--sl-color-gray-5);
    stop-opacity: 0;
  }
  .fog-text {
    font-size: 11px;
    fill: var(--sl-color-gray-3);
  }
  .connector {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .arrowhead {
    fill: var(--sl-color-gray-4);
  }
  .refine {
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .refine-text {
    font-size: 11px;
    fill: var(--sl-color-accent-high);
  }
</style>
